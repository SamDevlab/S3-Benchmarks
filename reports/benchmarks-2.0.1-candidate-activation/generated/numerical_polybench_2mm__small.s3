    discard f64_vector_push(&mut out, 0.0)
    discard f64_vector_push(&mut out, 0.0)
    mut i: i64 = 0
    while i < 3:
        mut j: i64 = 0
        while j < 4:
            mut k: i64 = 0
            mut total: f64 = 0.0
            while k < 2:
                mut ai: i64 = i * to_i64(2) + k
                mut bk: i64 = k * to_i64(4) + j
                total = total + f64_vector_get(&a, ai) * f64_vector_get(&b, bk)
                k = k + 1
            mut tmp_index: i64 = i * to_i64(4) + j
            discard f64_vector_set(&mut tmp, tmp_index, total)
            j = j + 1
        i = i + 1
    i = 0
    while i < 3:
        mut j: i64 = 0
        while j < 4:
            mut k: i64 = 0
            mut total2: f64 = 0.0
            while k < 2:
                mut ci: i64 = i * to_i64(2) + k
                mut dj: i64 = k * to_i64(4) + j
                total2 = total2 + f64_vector_get(&c, ci) * f64_vector_get(&d, dj)
                k = k + 1
            mut out_index: i64 = i * to_i64(4) + j
            mut value: f64 = f64_vector_get(&tmp, out_index) + total2
            discard f64_vector_set(&mut out, out_index, value)
            j = j + 1
        i = i + 1
    mut checksum: f64 = 0.0
    mut index: i64 = 0
    while index < 12:
