    discard f64_vector_push(&mut d, 6.0)
    discard f64_vector_push(&mut d, 7.0)
    discard f64_vector_push(&mut d, 8.0)
    discard f64_vector_push(&mut d, 9.0)
    discard f64_vector_push(&mut d, 10.0)
    discard f64_vector_push(&mut d, 11.0)
    mut tmp: f64_vector = f64_vector_new(12)
    discard f64_vector_push(&mut tmp, 0.0)
    discard f64_vector_push(&mut tmp, 0.0)
    discard f64_vector_push(&mut tmp, 0.0)
    discard f64_vector_push(&mut tmp, 0.0)
    discard f64_vector_push(&mut tmp, 0.0)
    discard f64_vector_push(&mut tmp, 0.0)
