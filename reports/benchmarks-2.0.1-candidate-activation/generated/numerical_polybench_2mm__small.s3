    discard f64_vector_push(&mut tmp, 0.0)
    discard f64_vector_push(&mut tmp, 0.0)
    discard f64_vector_push(&mut tmp, 0.0)
    mut out: f64_vector = f64_vector_new(12)
    discard f64_vector_push(&mut out, 0.0)
    discard f64_vector_push(&mut out, 0.0)
    discard f64_vector_push(&mut out, 0.0)
    discard f64_vector_push(&mut out, 0.0)
    discard f64_vector_push(&mut out, 0.0)
    discard f64_vector_push(&mut out, 0.0)
    discard f64_vector_push(&mut out, 0.0)
