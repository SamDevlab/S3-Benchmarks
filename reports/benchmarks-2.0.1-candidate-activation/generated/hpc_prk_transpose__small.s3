fn candidate_sqrt(value: f64) -> f64:
    return sqrt(value)

fn main() -> f64:
    mut input: f64_vector = f64_vector_new(12)
    discard f64_vector_push(&mut input, 1.0)
    discard f64_vector_push(&mut input, 2.0)
    discard f64_vector_push(&mut input, 3.0)
    discard f64_vector_push(&mut input, 4.0)
    discard f64_vector_push(&mut input, 5.0)
    discard f64_vector_push(&mut input, 6.0)
    discard f64_vector_push(&mut input, 7.0)
    discard f64_vector_push(&mut input, 8.0)
    discard f64_vector_push(&mut input, 9.0)
    discard f64_vector_push(&mut input, 10.0)
    discard f64_vector_push(&mut input, 11.0)
    discard f64_vector_push(&mut input, 12.0)
    mut output: f64_vector = f64_vector_new(12)
    discard f64_vector_push(&mut output, 0.0)
    discard f64_vector_push(&mut output, 0.0)
    discard f64_vector_push(&mut output, 0.0)
    discard f64_vector_push(&mut output, 0.0)
    discard f64_vector_push(&mut output, 0.0)
    discard f64_vector_push(&mut output, 0.0)
    discard f64_vector_push(&mut output, 0.0)
    discard f64_vector_push(&mut output, 0.0)
    discard f64_vector_push(&mut output, 0.0)
    discard f64_vector_push(&mut output, 0.0)
    discard f64_vector_push(&mut output, 0.0)
    discard f64_vector_push(&mut output, 0.0)
    mut i: i64 = 0
    while i < 3:
        mut j: i64 = 0
        while j < 4:
            mut source_index: i64 = i * to_i64(4) + j
            mut destination_index: i64 = j * to_i64(3) + i
            mut value: f64 = f64_vector_get(&input, source_index)
            discard f64_vector_set(&mut output, destination_index, value)
            j = j + 1
        i = i + 1
    mut index: i64 = 0
    mut checksum: f64 = 0.0
    while index < 12:
        mut value: f64 = f64_vector_get(&output, index)
        checksum = checksum + (to_f64(index) + 1.0) * value
        index = index + 1
    return checksum
