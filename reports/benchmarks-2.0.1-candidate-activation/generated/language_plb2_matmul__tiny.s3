fn candidate_sqrt(value: f64) -> f64:
    return sqrt(value)

fn main() -> f64:
    mut a: f64_vector = f64_vector_new(4)
    discard f64_vector_push(&mut a, 1.0)
    discard f64_vector_push(&mut a, 2.0)
    discard f64_vector_push(&mut a, 3.0)
    discard f64_vector_push(&mut a, 4.0)
    mut b: f64_vector = f64_vector_new(6)
    discard f64_vector_push(&mut b, 2.0)
    discard f64_vector_push(&mut b, 3.0)
    discard f64_vector_push(&mut b, 4.0)
    discard f64_vector_push(&mut b, 5.0)
    discard f64_vector_push(&mut b, 6.0)
    discard f64_vector_push(&mut b, 7.0)
    mut c: f64_vector = f64_vector_new(6)
    discard f64_vector_push(&mut c, 1.0)
    discard f64_vector_push(&mut c, 1.0)
    discard f64_vector_push(&mut c, 1.0)
    discard f64_vector_push(&mut c, 1.0)
    discard f64_vector_push(&mut c, 1.0)
    discard f64_vector_push(&mut c, 1.0)
    mut i: i64 = 0
    while i < 2:
        mut j: i64 = 0
        while j < 3:
            mut k: i64 = 0
            mut total: f64 = 1.0
            while k < 2:
                mut a_index: i64 = i * to_i64(2) + k
                mut b_index: i64 = k * to_i64(3) + j
                total = total + f64_vector_get(&a, a_index) * f64_vector_get(&b, b_index)
                k = k + 1
            mut c_index: i64 = i * to_i64(3) + j
            discard f64_vector_set(&mut c, c_index, total)
            j = j + 1
        i = i + 1
    mut checksum: f64 = 0.0
    mut index: i64 = 0
    while index < 6:
        checksum = checksum + f64_vector_get(&c, index)
        index = index + 1
    return checksum
