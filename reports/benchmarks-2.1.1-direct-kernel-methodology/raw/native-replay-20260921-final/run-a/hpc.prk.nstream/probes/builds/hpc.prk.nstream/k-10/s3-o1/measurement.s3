    discard f64_vector_push(&mut c, 1.0)
    discard f64_vector_push(&mut c, 1.0)
    mut repetition: i64 = 0
    mut last_result: f64 = 0.0
    while repetition < 10:
        mut i: i64 = 0
        mut total: f64 = 0.0
        while i < 31:
            mut av: f64 = f64_vector_get(&a, i)
            mut bv: f64 = f64_vector_get(&b, i)
            mut cv: f64 = f64_vector_get(&c, i)
            mut value: f64 = av + bv + 2.0 * cv
            discard f64_vector_set(&mut a, i, value)
            total = total + value
            i = i + 1
        last_result = total
        repetition = repetition + 1
    match last_result <=> 6386.0:
        -1:
            return 0
        0:
            return 1
        1:
            return 0
