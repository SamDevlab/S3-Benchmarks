                    total = total + f64_vector_get(&a, a_index) * f64_vector_get(&b, b_index)
                    k = k + 1
                mut c_index: i64 = i * to_i64(16) + j
                discard f64_vector_set(&mut c, c_index, total)
                j = j + 1
            i = i + 1
        mut checksum: f64 = 0.0
        mut index: i64 = 0
        while index < 192:
            checksum = checksum + f64_vector_get(&c, index)
            index = index + 1
        last_result = checksum
        repetition = repetition + 1
    match last_result <=> 5008704.0:
        -1:
            return 0
        0:
            return 1
        1:
            return 0
