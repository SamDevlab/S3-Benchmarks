{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SamDevlab/S3-Benchmarks/schemas/s3-1.8-result-v1.schema.json",
  "title": "S3 1.8 compiler science experiment registry",
  "type": "object",
  "required": ["schema_version", "campaign_id", "provenance", "experiments", "hypotheses", "negative_results", "research_questions"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "campaign_id": {"const": "S3_1_8_MACHINE_INTELLIGENCE_VERIFIED_OPTIMIZATION_PORTABLE_COMPUTE_AND_COMPILER_SCIENCE_LAB"},
    "provenance": {
      "type": "object",
      "required": ["s3_campaign_base", "s3_candidate_head", "bench_campaign_base", "manifest_sha256"],
      "properties": {
        "s3_campaign_base": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "s3_candidate_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "bench_campaign_base": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "experiments": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["experiment_id", "research_question", "maturity", "classification", "protocol", "evidence_artifacts", "observations"],
        "properties": {
          "experiment_id": {"type": "string", "pattern": "^EXP-S3-18-[A-Z0-9-]+$"},
          "research_question": {"type": "string", "minLength": 1},
          "maturity": {"enum": ["QUALIFIED", "EXPERIMENTAL", "PROTOTYPE", "DESIGN", "PARTIAL", "DEFERRED_WITH_EVIDENCE", "REJECTED_WITH_EVIDENCE", "INCONCLUSIVE", "NOT_STARTED"]},
          "classification": {"type": "string", "minLength": 1},
          "protocol": {"type": "object"},
          "evidence_artifacts": {"type": "array", "items": {"type": "object", "required": ["path", "sha256"]}},
          "observations": {"type": "object"}
        }
      }
    },
    "hypotheses": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": ["hypothesis_id", "research_question", "status", "experiment_ids", "statement"],
        "properties": {
          "hypothesis_id": {"type": "string", "pattern": "^HYP-S3-18-[0-9]{3}$"},
          "research_question": {"type": "string", "pattern": "^RQ([1-9]|10)$"},
          "status": {"enum": ["OPEN", "SUPPORTED", "REFUTED", "PARTIAL", "INCONCLUSIVE"]},
          "experiment_ids": {"type": "array", "items": {"type": "string", "pattern": "^EXP-S3-18-[A-Z0-9-]+$"}},
          "statement": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "negative_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["result_id", "experiment_id", "observation", "interpretation"],
        "properties": {
          "result_id": {"type": "string", "pattern": "^NEG-S3-18-[0-9]{3}$"},
          "experiment_id": {"type": "string", "pattern": "^EXP-S3-18-[A-Z0-9-]+$"},
          "observation": {"type": "string", "minLength": 1},
          "interpretation": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "research_questions": {"type": "array", "minItems": 10}
  },
  "additionalProperties": false
}
