{
  "id": "scientific.rmsd.single",
  "family": "scientific",
  "description": "Root mean square deviation over two equal-length scalar vectors.",
  "upstream_reference": "charnley.rmsd",
  "upstream_sha": "1ad8ecee48d95ab43b49bd9f2fe4f8f07d9106bd",
  "work_unit": "one scalar coordinate comparison",
  "input_sizes": ["tiny", "small", "medium", "large"],
  "reference_variants": ["python-oracle"],
  "s3_variants": ["S3-O0", "S3-O1"],
  "correctness_contract": {
    "formula": "sqrt(sum((A[i]-B[i])**2)/N)",
    "empty_input": "reject",
    "length_mismatch": "reject",
