    "relative_tolerance": 1e-12,
    "anti_dce": "observable scalar result"
  },
  "build_recipe": {"s3_source": "rmsd.s3", "reference": "reference.py"},
  "run_recipe": {"mode": "bounded_native_or_hosted", "network": false},
  "measurement_protocol": {
    "timing_scope": "KERNEL",
    "warmups": 1,
    "repetitions": 5,
    "target_sample_duration_ns": null,
    "interleaved": true,
    "synthetic_timing": false
  },
  "capability_requirements": ["f64", "f64_vector", "while", "dynamic_call", "native_sse2_sqrt"],
  "status": "CORRECTNESS_PASS"
}
