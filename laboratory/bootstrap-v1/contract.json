{
  "schema": "s3.bootstrap-laboratory.v1",
  "purpose": "Measure S3 self-hosting progress without converting missing artifacts, host-oracle measurements, or environment limitations into correctness or performance claims.",
  "fundamental_rule": "CORRECTNESS_BEFORE_PERFORMANCE",
  "allowed_states": [
    "PASS",
    "FAIL",
    "BLOCKED",
    "NOT_STARTED",
    "NOT_CREATED",
    "NOT_AUTHORIZED",
    "DEFERRED",
    "CHARACTERIZATION_ONLY",
    "INCONCLUSIVE_ENVIRONMENT"
  ],
  "stages": [
    "stage0_reference",
    "stage1",
    "stage2",
    "stage3"
  ],
  "semantic_surfaces": [
    "typed_values",
    "instruction_def_use",
    "call_dataflow",
    "complete_terminators",
    "canonical_serialization"
  ],
  "required_sections": [
    "provenance",
    "bootstrap",
    "semantic_ir",
    "determinism",
    "resources",
    "performance_eligibility"
  ],
  "promotion_rules": {
    "stage2_requires": [
      "stage1_self_emit_pass",
      "all_semantic_surfaces_pass",
      "canonical_serialization_pass"
    ],
    "stage3_requires": [
      "stage2_created",
      "stage2_correctness_pass"
    ],
    "full_self_hosting_requires": [
      "stage1_self_emit_pass",
      "stage2_correctness_pass",
      "stage3_correctness_pass",
      "stage1_stage2_stage3_equivalence_pass"
    ],
    "performance_requires": [
      "correctness_pass",
      "equivalent_workload",
      "stable_environment",
      "source_lock_valid",
      "benchmark_lock_valid"
    ]
  },
  "prohibited_claims": [
    "host_oracle_as_stage1_evidence",
    "structural_reduction_as_speedup",
    "characterization_only_as_native_comparative",
    "blocked_stage_as_pass",
    "missing_artifact_as_zero_cost",
    "historical_result_relabelled_to_new_source_without_rerun"
  ],
  "resource_metrics": [
    "peak_rss_bytes",
    "compile_wall_seconds",
    "artifact_bytes",
    "assembly_bytes",
    "semantic_value_count",
    "instruction_count",
    "block_count",
    "call_count"
  ],
  "resource_policy": {
    "classification": "CHARACTERIZATION_ONLY_UNTIL_CORRECTNESS_AND_EQUIVALENCE_PASS",
    "host_oracle_may_select_architecture": true,
    "host_oracle_may_size_stage1_arrays_directly": false
  }
}
