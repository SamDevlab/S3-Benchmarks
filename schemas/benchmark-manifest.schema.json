{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "s3.benchmark.manifest.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "family", "description", "work_unit", "input_sizes", "reference_variants", "s3_variants", "correctness_contract", "build_recipe", "run_recipe", "measurement_protocol", "capability_requirements", "status"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
    "family": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "upstream_reference": {"type": ["string", "null"]},
    "upstream_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "work_unit": {"type": "string", "minLength": 1},
    "input_sizes": {"type": "array", "items": {"type": "string"}},
    "reference_variants": {"type": "array", "items": {"type": "string"}},
    "s3_variants": {"type": "array", "items": {"type": "string"}},
    "correctness_contract": {"type": "object"},
    "build_recipe": {"type": "object"},
    "run_recipe": {"type": "object"},
    "measurement_protocol": {"type": "object"},
    "capability_requirements": {"type": "array", "items": {"type": "string"}},
    "status": {"type": "string", "enum": ["CANDIDATE", "UPSTREAM_PINNED", "IMPLEMENTED", "CORRECTNESS_PASS", "NATIVE_PASS", "MEASURED", "REPRODUCED", "EXTERNALIZED", "NOT_SUPPORTED_YET"]}
  }
}
